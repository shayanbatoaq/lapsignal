{
  "name": "lapsignal",
  "version": "0.1.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "setup": "pnpm install && uv sync --project services/api",
    "seed": "uv run --project services/api python -m lapsignal.seed",
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"pnpm api:dev\" \"pnpm --filter @lapsignal/web dev\"",
    "dev:demo": "pnpm seed && pnpm dev",
    "api:dev": "uv run --project services/api uvicorn lapsignal.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint && uv run --project services/api ruff check services/api/lapsignal services/api/tests",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && uv run --project services/api pytest",
    "test:e2e": "pnpm --filter @lapsignal/web test:e2e",
    "collector:listen": "pnpm --filter @lapsignal/collector start listen --data-dir ../../data",
    "collector:replay": "pnpm --filter @lapsignal/collector start replay ../../data/fixtures/f1-2021-replay.jsonl --data-dir ../../data",
    "generate:client": "node scripts/generate-client.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "concurrently": "10.0.4",
    "typescript": "5.9.3"
  }
}
