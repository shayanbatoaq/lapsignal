    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop && playwright test --project=mobile",
    "test:e2e:showcase": "playwright test --config=playwright.showcase.config.ts"
  },
  "dependencies": {
    "@lapsignal/contracts": "workspace:*",
    "@lapsignal/design-system": "workspace:*",
    "@lapsignal/telemetry-domain": "workspace:*",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.101.4",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.5",
    "lucide-react": "1.31.0",
    "motion": "13.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@vitejs/plugin-react": "6.0.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "27.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.10"
  }
