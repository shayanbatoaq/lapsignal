{
  "name": "@lapsignal/web",
  "version": "0.1.0-alpha.4",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": { "node": ">=22.13.0 <23" },
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings=0",
