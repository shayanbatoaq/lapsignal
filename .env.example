APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/local/lapsignal.db
DATA_DIR=./data
API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

COLLECTOR_BIND_ADDRESS=0.0.0.0
COLLECTOR_UDP_PORT=20777
COLLECTOR_API_URL=http://localhost:8000

OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-5.6-luna
OPENAI_DEEP_MODEL=gpt-5.6-terra

# Server-side AI provider. The canonical file is this repository root's .env.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_COACH_MODEL=openai/gpt-5-mini
OPENROUTER_DEEP_MODEL=openai/gpt-5.2
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=LapSignal
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=false
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=0
AI_CACHE_ENABLED=true
AI_LIVE_LAP_COACHING=false

GIT_SHA=
BUILD_NUMBER=3
